#!/usr/bin/env bash

set -euo pipefail

PROJECTS="${PROJECTS:-$HOME/Projects}"

# Override with PROJECT_PICKER_BACKEND=herdr or herdr-app when launching outside
# a managed terminal. The desktop app starts its terminals through herdr-core.
PROJECT_PICKER_BACKEND="${PROJECT_PICKER_BACKEND:-auto}"
if [[ "$PROJECT_PICKER_BACKEND" == auto ]]; then
  if [[ "${HERDR_ENV:-}" != 1 && -n "${HC_TERMINAL_ID:-}" ]]; then
    PROJECT_PICKER_BACKEND=herdr-app
  else
    PROJECT_PICKER_BACKEND=herdr
  fi
fi

create_project() {
  local project="$1"
  case "$project" in
  "" | . | .. | */*)
    printf 'Error: Project name must be a single directory name\n' >&2
    return 1
    ;;
  esac
  mkdir -p -- "$PROJECTS/$project"
}

# Print selected project names, creating a project for an unmatched query.
pick_projects() {
  local query="${1:-}"
  local project_names selection projects="" picker_status=0

  mkdir -p -- "$PROJECTS" || return
  project_names=$(fd . "$PROJECTS" --type d --max-depth 1 --exec basename {} \;) || return
  selection=$(printf '%s\n' "$project_names" | fzf --multi --print-query --query="$query") || picker_status=$?
  case "$picker_status" in
  0 | 1) ;;
  *) return "$picker_status" ;;
  esac

  query="${selection%%$'\n'*}"
  if [[ "$selection" == *$'\n'* ]]; then
    projects="${selection#*$'\n'}"
  fi

  if [[ -z "$projects" ]]; then
    [[ -n "$query" ]] || return 0
    create_project "$query" || return
    projects="$query"
  fi
  printf '%s\n' "$projects"
}

create_command_tab() {
  local workspace_id="$1" project_dir="$2" command="$3"
  local tab pane_id args

  if [[ "$PROJECT_PICKER_BACKEND" == herdr-app ]]; then
    args=$(jq -cn --arg space "$workspace_id" --arg folder "$project_dir" --arg command "$command" \
      '{space: $space, folder: $folder, name: $command, argv: [$command]}') || return
    herdr-app 'do' tab.new "$args" >/dev/null
    return
  fi

  tab=$(herdr tab create --workspace "$workspace_id" --cwd "$project_dir" --label "$command") || return
  pane_id=$(printf '%s' "$tab" | jq -r '.result.root_pane.pane_id') || return
  herdr pane run "$pane_id" "$command" >/dev/null
}

# Print the pi tab ID; keep other Herdr responses out of this return value.
create_project_workspace() {
  local project="$1"
  local project_dir="$PROJECTS/$project"
  local workspace workspace_id pi_tab_id pi_pane_id args

  if [[ "$PROJECT_PICKER_BACKEND" == herdr-app ]]; then
    args=$(jq -cn --arg name "$project" --arg folder "$project_dir" \
      '{name: $name, folder: $folder, tab: "pi", argv: ["pi", "--continue"]}') || return
    workspace=$(herdr-app 'do' space.new "$args") || return
    workspace_id=$(printf '%s' "$workspace" | jq -er '.space | strings | select(length > 0)') || return
    pi_tab_id=$(printf '%s' "$workspace" | jq -er '.tab | strings | select(length > 0)') || return
  else
    workspace=$(herdr workspace create --cwd "$project_dir" --label "$project") || return
    workspace_id=$(printf '%s' "$workspace" | jq -r '.result.workspace.workspace_id') || return
    pi_tab_id=$(printf '%s' "$workspace" | jq -r '.result.tab.tab_id') || return
    pi_pane_id=$(printf '%s' "$workspace" | jq -r '.result.root_pane.pane_id') || return

    herdr tab rename "$pi_tab_id" pi >/dev/null || return
    herdr pane run "$pi_pane_id" "pi --continue" >/dev/null || return
  fi
  create_command_tab "$workspace_id" "$project_dir" nvim || return
  create_command_tab "$workspace_id" "$project_dir" bash || return
  printf '%s\n' "$pi_tab_id"
}

open_projects() {
  local projects="$1"
  local project pi_tab_id args first_pi_tab_id=""

  [[ -n "$projects" ]] || return 0
  while IFS= read -r project; do
    pi_tab_id=$(create_project_workspace "$project") || return
    if [[ -z "$first_pi_tab_id" ]]; then
      first_pi_tab_id="$pi_tab_id"
    fi
  done <<<"$projects"

  if [[ "$PROJECT_PICKER_BACKEND" == herdr-app ]]; then
    args=$(jq -cn --arg id "$first_pi_tab_id" '{id: $id}') || return
    herdr-app 'do' tab.select "$args"
  else
    herdr tab focus "$first_pi_tab_id"
  fi
}

main() {
  local projects
  case "$PROJECT_PICKER_BACKEND" in
  herdr | herdr-app) ;;
  *)
    printf 'Error: PROJECT_PICKER_BACKEND must be auto, herdr, or herdr-app\n' >&2
    return 1
    ;;
  esac
  projects=$(pick_projects "${1:-}") || return
  open_projects "$projects"
}

# Only run when executed directly, not when sourced.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
