#!/usr/bin/env python3
"""Print clickable OSC 8 file:// links; does not open files or call Herdr.

Examples (Ctrl-click the output inside Herdr):
    osc8-file-link README.md mise.toml
    osc8-file-link '/tmp/file with spaces.json'
"""

import argparse
from pathlib import Path


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("paths", nargs="+", help="Existing files or directories to link to")
    args = parser.parse_args()
    links = []
    for name in args.paths:
        try:
            path = Path(name).expanduser().resolve(strict=True)
        except (OSError, RuntimeError, ValueError) as error:
            parser.error(f"{name!r}: {error}")
        label = str(path)
        if not label.isprintable():
            parser.error(f"Refusing a path with non-printable characters: {label!r}")
        # as_uri percent-encodes spaces, #, %, Unicode, etc. ST terminates both
        # the opening OSC 8 and its closing sequence (no link bleed).
        links.append(f"\x1b]8;;{path.as_uri()}\x1b\\{label}\x1b]8;;\x1b\\")
    print("\n".join(links))


if __name__ == "__main__":
    main()
